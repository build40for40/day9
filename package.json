{
  "name": "nerds-of-fashion",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "vite",
    "dev:api": "mkdir -p dist && npm run wrangler -- dev",
    "build": "rm -rf dist && vite build",
    "preview": "npm run build && npm run wrangler -- dev",
    "test": "vitest run",
    "types": "wrangler types worker/worker-configuration.d.ts --env-file .dev.vars.example",
    "trend-index": "node src/intent/build-trend-index.mjs",
    "wrangler": "env -u CLOUDFLARE_API_KEY -u CLOUDFLARE_EMAIL wrangler --profile 40for40"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "d3-geo": "^3.1.2",
    "d3-shape": "^3.2.1",
    "vue": "^3.5.45"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/d3-geo": "^3.1.1",
    "@types/d3-shape": "^3.2.0",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vue/test-utils": "^2.5.1",
    "happy-dom": "^21.0.4",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "wrangler": "^4.161.0"
  }
}
